<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A2A2A"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp"
        android:layout_marginTop="-12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POS Offline Tester"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v1.0 - HCE Emulator"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Status Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#252525"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stare:"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inactiv"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/pb_test"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:max="100"
            android:progress="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verdict:"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nerezolvat"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Log Panel Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Timeline APDU"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Șterge"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Log RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D0D0D"
        android:padding="8dp" />

    <!-- Summary Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#252525"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rezumat Tranzacție:"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aşteptând test..."
            android:textSize="12sp"
            android:textColor="#BBBBBB"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp"
        android:layout_marginBottom="-12dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="START TEST"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXPORT"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
